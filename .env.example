# Server-side secret for the RAG backend (api/chat.ts) and the offline embedder
# (scripts/embed-corpus.mjs). NEVER ships to the client bundle.
# Local dev:  copy to `.env.local` and fill in, then run `vercel dev` / `npm run embed`.
# Vercel:     set it in Project Settings -> Environment Variables (or `vercel env add`).
GEMINI_API_KEY=

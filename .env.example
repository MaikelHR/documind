# Server-side secrets for the RAG backend (api/*) and the offline embedder
# (scripts/embed-corpus.mjs). NEVER ship to the client bundle.
# Local dev:  copy to `.env.local` and fill in, then run `vercel dev` / `npm run embed`.
# Vercel:     set them in Project Settings -> Environment Variables (or `vercel env add`).
GEMINI_API_KEY=

# Supabase (Postgres + pgvector) for user-uploaded documents (api/ingest.ts,
# api/page.ts, api/keepalive.ts and the user-chunk retrieval in api/chat.ts).
# The service-role key (new sb_secret_... format) is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: when set, /api/keepalive requires `Authorization: Bearer <secret>`
# (Vercel sends it automatically on cron invocations).
CRON_SECRET=
